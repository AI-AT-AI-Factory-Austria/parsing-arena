# Optional configuration for native runs. Copy to `.env` only if needed.
# Local parsing needs no API keys. For Docker configuration, see the README.

# Automatic judging: enter keys here OR save them through the app's confirmation
# dialog. Keys in `.env` take precedence over UI-saved keys. `.env` is gitignored.
# LlamaParse receives the selected pages; Mistral receives the extracted text.
LLAMA_CLOUD_API_KEY=
MISTRAL=

# LlamaParse keys are region-specific. The default is the US endpoint.
# Uncomment for an EU account:
# LLAMA_CLOUD_BASE_URL=https://api.cloud.eu.llamaindex.ai

# Hardware detection, model runtimes and judging already have defaults.
# For optional overrides, see docs/deployment.md and backend/app/config.py.
