# OCR Arena configuration. Copy this file to `.env` and fill in what you need.
# `.env` is gitignored, so your keys stay on your machine.

# --- LlamaParse (reference parser) ------------------------------------------
# Create a key at https://cloud.llamaindex.ai (API Keys). Agentic Plus costs
# about 45 credits per page.
LLAMA_CLOUD_API_KEY=
# Keys are region-specific. EU accounts use https://api.cloud.eu.llamaindex.ai
LLAMA_CLOUD_BASE_URL=https://api.cloud.llamaindex.ai

# --- Quality judge (Mistral API) -------------------------------------------------
# Compares each model's extracted text with the LlamaParse reference, page by page.
# Text from both outputs is sent to Mistral. New reference-backed runs are judged
# automatically; existing experiments offer a "Judge outputs" action.
MISTRAL=
# JUDGE_MODEL=mistral-large-4
# JUDGE_TIMEOUT_S=180
OPENROUTER=

# --- Open models ---------------------------------------------------------------
# Empty endpoint = run the model locally (GPU when PyTorch
# sees one, otherwise CPU). Set the URL of a vLLM server
# (http://gpu-host:8000/v1) to run it there instead; see the README for the
# serve command of each model.
RAKEDOC_NANO_ENDPOINT_URL=
AEDDIX_ALPINE_OCR_ENDPOINT_URL=
FLORIN_PARSER_NANO_ENDPOINT_URL=
LIGHTONOCR_3_0_8B_ENDPOINT_URL=
MINERU2_5_PRO_2605_ENDPOINT_URL=
INFINITY_PARSER2_FLASH_ENDPOINT_URL=
OVISOCR3_ENDPOINT_URL=
# The served model name defaults to what the README's serve command uses, e.g.
# LIGHTONOCR_3_0_8B_SERVED_MODEL=loocr-grounding
# VLLM_API_KEY=

# --- Tesseract -------------------------------------------------------------------
# Path to tesseract.exe if it is not on PATH or in C:\Program Files\Tesseract-OCR.
# TESSERACT_CMD=
# ParseBench uses English; German documents read better with deu+eng (needs the
# deu language data installed with Tesseract).
# TESSERACT_LANG=eng

# --- Library preset runtimes -----------------------------------------------------
# Empty = auto-discover portable tools under data/runtimes, then system PATH.
# Marker defaults to backend/runtimes/marker/.venv.
# MARKER_PYTHON=
# JAVA_CMD=
# LLAMA_CPP_BINARY=
# SkyVision CPU uses the F16 Nemotron GGUF with a separately built local executable.
# SKYVISION_BINARY=         # default: data/runtimes/skyvision/vqa-cli(.exe)
# SKYVISION_THREADS=0       # 0 = auto (physical CPU cores)
# SKYVISION_TIMEOUT_S=1200  # per load/page request
# Unlimited-OCR 2 has a separate patched runtime: backend/scripts/install-unlimited.py
# BF16 decoder + F16 vision; all selected pages in ONE request, local Vulkan/CUDA.
# This runtime uses masked dense attention: memory grows with document length.
# UNLIMITED_OCR_2_CONTEXT_LENGTH=32768
# UNLIMITED_OCR_2_MAX_TOKENS=24000
# UNLIMITED_OCR_2_MAX_PAGES=16

# --- Local inference -------------------------------------------------------------
# auto detects the server hardware. Explicit profiles validate it at run time.
RUNTIME_PROFILE=auto        # auto | windows-amd | linux-nvidia
# windows-amd uses Vulkan GGUF F16 for LightOnOCR-3, Infinity-Parser2 and OvisOCR3;
# other GPU models keep ROCm. linux-nvidia uses native CUDA/Transformers.
# LOCAL_DEVICE=auto          # auto | cuda | cpu
# LOCAL_DTYPE=auto           # auto | bfloat16 | float16 | float32
# LOCAL_MAX_BATCH=8          # requests decoded together
# KEEP_MODELS_LOADED=true    # keep weights in memory between experiments
# MAX_LOADED_MODELS=2        # at most this many checkpoints in memory at once
# Unsafe native ROCm paths remain blocked. The Windows/AMD profile uses Vulkan
# alternatives where available; this flag is not needed for those alternatives.
# ALLOW_UNSTABLE_ROCM_MODELS=false

# --- Limits ----------------------------------------------------------------------
# MAX_UPLOAD_MB=100
# MAX_PAGES_PER_EXPERIMENT=50
